{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "test",
        "EXPO_PUBLIC_API_BASE_URL": "https://testv3.appkora.com/api",
        "EXPO_PUBLIC_FEATURE_ENGLISH": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "test",
        "EXPO_PUBLIC_API_BASE_URL": "https://testv3.appkora.com/api",
        "EXPO_PUBLIC_FEATURE_ENGLISH": "true"
      }
    },
    "preview-live": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://v3.appkora.com/api",
        "EXPO_PUBLIC_FEATURE_ENGLISH": "true",
        "EXPO_PUBLIC_READ_ONLY": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://v3.appkora.com/api",
        "EXPO_PUBLIC_FEATURE_ENGLISH": "false"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
