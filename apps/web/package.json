{
  "name": "@sports247/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live --port 5174",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && vite build --mode test",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/cairo": "^5.2.6",
    "@sports247/api": "workspace:*",
    "@sports247/data": "workspace:*",
    "@sports247/domain": "workspace:*",
    "@sports247/i18n": "workspace:*",
    "@sports247/tokens": "workspace:*",
    "@sentry/react": "^9.0.0",
    "@tanstack/query-sync-storage-persister": "^5.87.1",
    "@tanstack/react-query": "^5.87.1",
    "@tanstack/react-query-persist-client": "^5.87.1",
    "dompurify": "^3.2.6",
    "i18next": "^25.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-router": "^7.8.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
