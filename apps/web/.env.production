# `pnpm build`: production API. English stays hidden until the API serves English content.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://v3.appkora.com/api
VITE_FEATURE_ENGLISH=false
VITE_LIVE_POLL_MS=30000
# Public site origin for canonical URLs and sitemap.xml, e.g. https://www.example.com (pending).
VITE_SITE_URL=
VITE_SENTRY_DSN=
