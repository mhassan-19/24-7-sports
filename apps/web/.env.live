# `pnpm dev:web:live`: development server reading REAL data from the production API.
# Read-only: a development build refuses to send writes (game answers) to v3.appkora.com.
VITE_APP_ENV=production
VITE_API_BASE_URL=https://v3.appkora.com/api
VITE_FEATURE_ENGLISH=true
VITE_LIVE_POLL_MS=30000
VITE_SITE_URL=
VITE_SENTRY_DSN=
